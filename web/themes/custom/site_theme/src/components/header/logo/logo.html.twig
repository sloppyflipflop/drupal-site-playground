
{{ attach_library('site_theme/logo') }}

<a
  class="site-logo"
  href="https://www.asu.edu/"
  aria-label="{{ 'Arizona State University home'|t }}"
>
  <picture>
    <source
      media="(max-width: 1260px)"
      srcset="{{ base_path ~ directory }}/src/components/header/logo/assets/arizona-state-university-logo.png"
    >

    <img
      src="{{ base_path ~ directory }}/src/components/header/logo/assets/arizona-state-university-logo-vertical.png"
      alt="{{ 'Arizona State University'|t }}"
      width="303"
      height="234"
      fetchpriority="high"
      decoding="async"
    >
  </picture>
</a>
